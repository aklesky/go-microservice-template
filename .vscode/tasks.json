{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "go: tidy",
            "type": "shell",
            "command": "go mod tidy",
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "air: start",
            "type": "shell",
            "command": "air",
            "problemMatcher": [
                "$go"
            ],
            "dependsOn": [
                "go: tidy"
            ]
        },
        {
            "label": "air: terminate",
            "type": "shell",
            "command": "pkill -f air",
            "problemMatcher": []
        }
    ]
}
